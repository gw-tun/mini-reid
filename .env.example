# Local mini-reid defaults. Copy to .env before running the stack.
POSTGRES_DB=mini_reid
POSTGRES_USER=mini_reid
POSTGRES_PASSWORD=change_me_for_local_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://mini_reid:change_me_for_local_dev@localhost:5434/mini_reid
MEDIAMTX_RTSP_BASE=rtsp://localhost:8554
MEDIAMTX_API_URL=http://localhost:9997
API_PORT=8000
DEVICE=cpu
MODEL_ROOT=models
YOLO_WEIGHTS=models/yolo/yolo11m.pt
YOLO_CONFIG_DIR=data/cache/ultralytics
REID_BACKEND=fastreid
SAMPLE_FPS=2
REID_REFRESH_OBSERVATIONS=4
JOB_QUEUE_DIR=data/cache/job-queue
# ReID thresholds; recalibrate with scripts/calibrate_thresholds.py on real
# footage and update reid_threshold_policies to match.
REID_MIN_SIMILARITY=0.628
REID_MIN_MARGIN=0.0696
